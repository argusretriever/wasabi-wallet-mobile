<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WalletWasabi.Mobile.WalletSetupView" Background="#1F1F1F">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,24" Spacing="16" MaxWidth="560">
      <Grid ColumnDefinitions="Auto,*">
        <Image Source="/Assets/WasabiLogo.png" Width="32" Height="32" />
        <TextBlock Grid.Column="1" Text="Wasabi Wallet" Margin="12,0,0,0"
                   FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
      </Grid>
      <TextBlock Text="Testnet wallet" FontSize="24" FontWeight="SemiBold" />
      <Border Classes="card">
        <TextBlock Text="TESTNET4 · DEVICE STORAGE&#10;Your wallet is saved with device protection and password-encrypted keys. Keep your recovery words and exact password. Sync requires a local Tor service. Payments are pending."
                   TextWrapping="Wrap" Foreground="#C7E99A" />
      </Border>
      <StackPanel x:Name="SetupForm" Spacing="12">
        <TextBlock Text="Recovery phrase" />
        <TextBox x:Name="RecoveryInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                 TextInputOptions.IsSensitive="True" TextInputOptions.ShowSuggestions="False"
                 TextInputOptions.AutoCapitalization="False"
                 Watermark="Enter an English BIP39 phrase to recover, or leave empty to create."
                 AutomationProperties.Name="Recovery phrase" />
        <TextBlock Text="Wallet password / recovery passphrase" TextWrapping="Wrap" />
        <TextBox x:Name="PasswordInput" PasswordChar="●" TextInputOptions.IsSensitive="True" TextInputOptions.ShowSuggestions="False" TextInputOptions.AutoCapitalization="False" AutomationProperties.Name="Wallet password" />
        <TextBlock Classes="caption" Text="Wasabi uses this exact password to derive the wallet. A different password creates different addresses. Use the desktop wallet's original password when recovering."
                   TextWrapping="Wrap" />
        <TextBlock Text="Confirm password" />
        <TextBox x:Name="ConfirmInput" PasswordChar="●" TextInputOptions.IsSensitive="True" TextInputOptions.ShowSuggestions="False" TextInputOptions.AutoCapitalization="False" AutomationProperties.Name="Confirm password" />
        <TextBlock Text="Local unlock password (12+ characters)" TextWrapping="Wrap" />
        <TextBox x:Name="LocalPassword" PasswordChar="●" TextInputOptions.IsSensitive="True" TextInputOptions.ShowSuggestions="False" TextInputOptions.AutoCapitalization="False" AutomationProperties.Name="Local unlock password" />
        <TextBlock x:Name="LocalPasswordStrength" Classes="caption" IsVisible="False"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBox x:Name="LocalConfirm" PasswordChar="●" TextInputOptions.IsSensitive="True" TextInputOptions.ShowSuggestions="False" TextInputOptions.AutoCapitalization="False" Watermark="Confirm local unlock password" AutomationProperties.Name="Confirm local unlock password" />
        <TextBlock Classes="caption" Text="This password unlocks the saved wallet on this phone. It does not change the recovery passphrase or wallet addresses." TextWrapping="Wrap" />
        <Button Classes="action" Content="Create testnet wallet" Click="CreateWallet" />
        <Button Classes="action" Content="Recover testnet wallet" Click="RecoverWallet" />
      </StackPanel>
      <TextBlock x:Name="SetupStatus" TextWrapping="Wrap" Foreground="#C7E99A"
                 AutomationProperties.LiveSetting="Polite" />
      <StackPanel x:Name="BackupPanel" IsVisible="False" Spacing="14">
        <TextBlock Text="Write down your recovery phrase" FontSize="20" TextWrapping="Wrap" />
        <Border Classes="card">
          <TextBlock x:Name="RecoveryDisplay" TextWrapping="Wrap" FontSize="18" />
        </Border>
        <TextBlock Text="Keep these words and your exact password privately. They are needed to recover this wallet. The app saves encrypted wallet keys, never your recovery phrase or password."
                   TextWrapping="Wrap" />
        <TextBlock Text="Confirm words 1, 6 and 12 from your backup" TextWrapping="Wrap" />
        <TextBox x:Name="WordOne" Watermark="Word 1" TextInputOptions.IsSensitive="True" TextInputOptions.ShowSuggestions="False" />
        <TextBox x:Name="WordSix" Watermark="Word 6" TextInputOptions.IsSensitive="True" TextInputOptions.ShowSuggestions="False" />
        <TextBox x:Name="WordTwelve" Watermark="Word 12" TextInputOptions.IsSensitive="True" TextInputOptions.ShowSuggestions="False" />
        <CheckBox x:Name="BackupConfirmed" Content="I saved my words and password"
                  IsCheckedChanged="BackupConfirmationChanged" />
        <Button x:Name="OpenButton" Classes="action" Content="Save and open wallet"
                IsEnabled="False" Click="OpenWallet" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
