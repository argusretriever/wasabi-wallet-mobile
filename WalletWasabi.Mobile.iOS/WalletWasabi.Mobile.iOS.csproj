<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>io.github.argusretriever.wasabiwalletmobile.preview</ApplicationId>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'iossimulator-arm64'">
    <MtouchRegistrar>static</MtouchRegistrar>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
    <PackageReference Include="SkiaSharp.NativeAssets.iOS" />
    <ProjectReference Include="../WalletWasabi.Mobile/WalletWasabi.Mobile.csproj" />
  </ItemGroup>
</Project>
