<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <ApplicationId>io.github.argusretriever.wasabiwalletmobile.preview</ApplicationId>
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>0.2</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- The native Java HTTP handler treats the Tor SOCKS proxy as HTTP CONNECT. -->
    <UseNativeHttpHandler>false</UseNativeHttpHandler>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="SkiaSharp.NativeAssets.Android" />
    <ProjectReference Include="../WalletWasabi.Mobile/WalletWasabi.Mobile.csproj" />
    <AndroidResource Include="../Contrib/Assets/WasabiLogo256.png" Link="Resources/drawable/wasabi_logo.png" />
  </ItemGroup>
</Project>
